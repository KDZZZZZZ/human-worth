[Unit]
Description=Publish CI-approved Human Worth frontend to the existing ECS gateway
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=oops
Environment=PATH=/home/oops/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/oops/.config/human-worth/deploy.env
WorkingDirectory=/usr/local/lib/human-worth
ExecStart=/usr/bin/python3 /usr/local/lib/human-worth/frontend_release.py
TimeoutStartSec=2400
TimeoutStopSec=45
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/oops/.local/share/human-worth-frontend

